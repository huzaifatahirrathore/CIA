{
   "compilerOptions": {
      "lib": [
         "ES2020"
      ],
      "types": ["node"],
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "ignoreDeprecations": "6.0",
      "rootDir": "./src",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "useDefineForClassFields": false,
      "sourceMap": true,
      "strictPropertyInitialization": false,
      "esModuleInterop": true,
      "skipLibCheck": true
   }
}
