      "@types/swagger-stats": "^0.95.11",
      "@types/swagger-ui-express": "^4.1.8",
      "jest": "^29.7.0",
      "prettier": "^3.8.3",
      "supertest": "^7.2.2",
      "ts-jest": "^29.4.11",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "tsc-watch": "^7.2.0",
      "tslint": "^5.20.0",
      "tslint-config-prettier": "^1.18.0",
      "tslint-eslint-rules": "^5.4.0",
      "tslint-plugin-prettier": "^2.0.1",
      "typescript": "^6.0.3"
   },
   "dependencies": {
      "@sentry/node": "^10.55.0",
