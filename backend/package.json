      "winston": "^3.19.0"
   },
   "scripts": {
      "tsc": "tsc",
      "start": "ts-node-dev --respawn --transpile-only src/index.ts",
      "dev": "ts-node-dev --respawn --transpileOnly ./src/index.ts",
      "schema:drop": "typeorm-ts-node-commonjs -d src/data-source.ts schema:drop",
      "schema:sync": "typeorm-ts-node-commonjs -d src/data-source.ts schema:sync",
      "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
      "test": "jest --maxWorkers=1 --verbose=true",
      "migration:start": "npm run schema:drop && npm run schema:sync && npm run migration:run"
   }
}
